<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema aplikasi. Aplikasi ini 100% Compose, jadi XML hanya menyetel dasar
         jendela dan transparansi system bar; seluruh warna antarmuka berasal dari
         MaterialTheme/LocalAppPalette di commonMain (lihat UiAppTheme).
         Parent tetap Material (tanpa dependensi ekstra); variant night di
         values-night mengatur warna system bar agar kontras di mode gelap. -->
    <style name="Theme.UIApp" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>

